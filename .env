# --- Environnement de développement ou de production ------
# Valeurs possibles : 'prod', 'dev'. Sachant que 'test' est une
# valeur possible mais est automatiquement set durant les tests 
APP_ENV=dev

# --------- Base de données ----------
# Configuration Production - MySQL
PROD_MYSQL_SERVEUR=localhost
PROD_MYSQL_PORT=3306
PROD_MYSQL_UTILISATEUR=root
PROD_MYSQL_MDP=
PROD_MYSQL_NOMDB=spectacle

# Configuration Test - MySQL
TEST_MYSQL_SERVEUR=localhost
TEST_MYSQL_PORT=3306
TEST_MYSQL_UTILISATEUR=root
TEST_MYSQL_MDP=
TEST_MYSQL_NOMDB=spectacle_test